{
  "manifest_version": 3,
  "name": "MeetScribe",
  "version": "0.12.0",
  "description": "Transcribe las reuniones de Google Meet y guarda cada intervención con el nombre de quien habla.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "unlimitedStorage", "identity"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["https://meet.google.com/*", "https://gospelgeek.com.co/*", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["format.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "MeetScribe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
